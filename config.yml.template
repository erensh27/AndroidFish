token: "__TOKEN__"

engines:
  standard:
    dir: "../engines"
    name: "stockfish"
    ponder: true
    silence_stderr: false
    move_overhead_multiplier: 1.0
    uci_options:
      Threads: __THREADS__
      Hash: __HASH__
      Move Overhead: 200
    limits:

syzygy:
  standard:
    enabled: false
    paths: []
    max_pieces: 7
    instant_play: true

gaviota:
  enabled: false
  paths: []
  max_pieces: 5

opening_books:
  enabled: true
  priority: 400
  books:
    standard:
      selection: weighted_random
      names:
        - Book1
        - Book2
        - Book3
        - Book4
        - Book5
        - Book6
        - Book7
        - Book8
        - Book9
        - Book10
        - Book11
        - Book12
        - Book13
        - Book14
        - Book15

online_moves:
  opening_explorer:
    enabled: false
    priority: 300
    only_without_book: false
    use_for_variants: false
    allow_repetitions: false
    min_time: 10
    timeout: 5
    min_games: 5
    only_with_wins: false
    selection: "performance"
    anti: false
  lichess_cloud:
    enabled: false
    priority: 200
    only_without_book: false
    use_for_variants: false
    allow_repetitions: false
    trust_eval: false
    min_eval_depth: 10
    min_time: 10
    timeout: 5
  chessdb:
    enabled: false
    priority: 100
    only_without_book: false
    allow_repetitions: false
    trust_eval: false
    min_time: 10
    timeout: 5
    best_move: false
  online_egtb:
    enabled: true
    min_time: 5
    timeout: 3

offer_draw:
  enabled: true
  score: 10
  consecutive_moves: 5
  min_game_length: 30
  against_humans: true

resign:
  enabled: true
  score: -700
  consecutive_moves: 5
  against_humans: true

challenge:
  concurrency: 1
  max_takebacks: 3

  human:
    bullet_with_increment_only: false
    variants:
      - standard
      - chess960
      - fromPosition
    time_controls:
      - bullet
      - blitz
      - rapid
      - classical
    modes:
      - casual
      - rated

  bot:
    bullet_with_increment_only: false
    variants:
      - standard
      - chess960
      - fromPosition
    time_controls:
      - bullet
      - blitz
      - rapid
      - classical
    modes:
      - casual
      - rated

matchmaking:
  delay: 120
  timeout: 10
  selection: weighted_random
  types:
    blitz_3_2:
      tc: 3+2
      min_rating_diff: 0
      max_rating_diff: 400
    rapid_10_0:
      tc: 10+0
      min_rating_diff: 0
      max_rating_diff: 400
    blitz_5_3:
      tc: 5+3
      min_rating_diff: 0
      max_rating_diff: 400
    bullet_1_1:
      tc: 1+1
      min_rating_diff: 0
      max_rating_diff: 400

tournament:
  waiting_period: 1
  tracked_users: []
  tracked_teams: []
  variants:
    - standard
    - chess960
    - fromPosition

messages:
  greeting: "Hi! I'm a bot running {engine} on a Moto G32. Good luck! Type !help for commands."
  goodbye: "Good game!"
  greeting_spectators: "Watching {engine} on a Moto G32. Type !help for commands."
  goodbye_spectators: "Thanks for watching."

whitelist: []
blacklist: []
online_blacklists: []

# IMPORTANT: The opening_books: books: section above and the books: section below must be kept in sync.
# To add/remove books:
# 1. Drop your .bin polyglot files into books/
# 2. Add an alias and relative path below (e.g. Book1: "../books/book1.bin")
# 3. Add the alias to opening_books: books: standard: names: above
books:
  Book1: "../books/book1.bin"
  Book2: "../books/book2.bin"
  Book3: "../books/book3.bin"
  Book4: "../books/book4.bin"
  Book5: "../books/book5.bin"
  Book6: "../books/book6.bin"
  Book7: "../books/book7.bin"
  Book8: "../books/book8.bin"
  Book9: "../books/book9.bin"
  Book10: "../books/book10.bin"
  Book11: "../books/book11.bin"
  Book12: "../books/book12.bin"
  Book13: "../books/book13.bin"
  Book14: "../books/book14.bin"
  Book15: "../books/book15.bin"
